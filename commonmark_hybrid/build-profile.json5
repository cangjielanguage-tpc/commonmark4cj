{
  "apiType": "stageMode",
  "buildOption": {
    "cangjieOptions": {
      "path": "./cjpm.toml",
      "flattenLibs": true
    },
    "arkOptions": {
      "obfuscation": {
        "ruleOptions": {
          "enable": false,
          "files": [
            "./obfuscation-rules.txt"
          ]
        },
        "consumerFiles": [
          "./consumer-rules.txt"
        ]
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "cangjieOptions": {
        "abiFilters": [
          "x86_64",
          "arm64-v8a"
        ]
      }
    },
    {
      "name": "debug",
      "cangjieOptions": {
        "arguments": ["-V"],
        "abiFilters": [
          "x86_64",
          "arm64-v8a"
        ]
      },
      "nativeLib": {
        "debugSymbol": {
          "strip": false
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest"
    }
  ]
}